  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["cloudpilot"],
      "targetBlank": true,
      "title": "CloudPilot Docs",
      "tooltip": "",
      "type": "link",
      "url": "https://github.com/Karthi-cruise/cloudpilot"
    }
  ],
